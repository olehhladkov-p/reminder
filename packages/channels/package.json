{
  "name": "@reminder/channels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reminder/core": "workspace:*",
    "resend": "4.8.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
