{
  "name": "@reminder/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
