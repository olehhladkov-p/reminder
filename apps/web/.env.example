VITE_API_URL=http://localhost:8787

# Must match the API's VAPID_PUBLIC_KEY (see root .env.example) - public key
# only, safe to expose client-side.
VITE_VAPID_PUBLIC_KEY=

# Must match the API's DEV_LOG_MAGIC_LINK (see root .env.example). When both
# are true, SignIn.tsx fetches the sign-in link from the API's dev-only
# endpoint and shows it directly on the page instead of "check your email".
VITE_DEV_LOG_MAGIC_LINK=false
