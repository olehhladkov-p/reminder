# Neon Postgres — project "reminder"
# Pooled connection (has "-pooler" in the hostname): used by apps/api and apps/worker at runtime.
DATABASE_URL=

# Direct/unpooled connection: used by drizzle-kit for migrations (generate/migrate/push/studio).
DATABASE_URL_DIRECT=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Resend (email channel) - only required if DEV_LOG_MAGIC_LINK is false.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Set to true to log the magic-link sign-in URL to the console instead of
# sending it through Resend - handy for local dev so you don't need a real
# Resend key or inbox. Leave unset/false everywhere else (never set this in
# render.yaml).
DEV_LOG_MAGIC_LINK=false

# Web Push (VAPID) - generate a keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT is a contact per RFC 8292: a mailto: address or an https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Comma-separated list of origins the PWA (apps/web) is served from - used
# by apps/api for CORS and better-auth's trustedOrigins, and by apps/worker
# (first entry only) to build reminder email links. Defaults to the Vite
# dev server if unset.
WEB_APP_ORIGIN=http://localhost:5173
